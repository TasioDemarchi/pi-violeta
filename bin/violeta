#!/bin/sh
# violeta launcher: isolated Pi agent dir, so it never touches gentle-shell's state.
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PI_CODING_AGENT_DIR="${VIOLETA_HOME:-$HOME/.violeta}/agent"
export PI_SKIP_VERSION_CHECK=1
mkdir -p "$PI_CODING_AGENT_DIR"

# Seeded ONLY on first run, never in the merged fragment below: Pi persists the
# selected model here, so overlaying it on every start would silently undo a
# /models choice. After this, the model is yours -- /mode and /models own it.
if [ ! -f "$PI_CODING_AGENT_DIR/settings.json" ]; then
	cat > "$PI_CODING_AGENT_DIR/settings.json" <<JSON
{
  "theme": "violeta",
  "quietStartup": true,
  "defaultProvider": "nan",
  "defaultModel": "deepseek-v4-flash",
  "packages": ["$ROOT"]
}
JSON
fi

# Model catalog is repo-owned (config/models.json) and synced on every start.
# The key itself is never copied: models.json resolves it at request time from
# violeta's own agent dir first, falling back to gentle-shell's, so violeta runs
# with or without gentle-shell installed.
# Atomic: a plain `cp` truncates first, so a violeta starting at the same
# moment could read a half-written catalogue and come up with no models at all.
cp "$ROOT/config/models.json" "$PI_CODING_AGENT_DIR/models.json.$$.tmp" \
	&& mv "$PI_CODING_AGENT_DIR/models.json.$$.tmp" "$PI_CODING_AGENT_DIR/models.json"

# Agents and modes are repo-owned too, and synced the same way: the philosophy
# lives in git with the harness instead of only in ~/.violeta, where a reinstall
# would take it with it. Files you add there yourself are left alone.
# Same atomicity: each file lands through its own PID-named temp, so a
# concurrent start never reads a definition that is half on disk.
for set in agents modes; do
	[ -d "$ROOT/$set" ] || continue
	mkdir -p "$PI_CODING_AGENT_DIR/$set"
	for f in "$ROOT/$set"/*.md; do
		[ -f "$f" ] || continue
		dest="$PI_CODING_AGENT_DIR/$set/$(basename "$f")"
		cp "$f" "$dest.$$.tmp" && mv "$dest.$$.tmp" "$dest"
	done
done

# The temp file carries the PID: two violetas starting at the same moment
# used the same name, so one moved it and the other died with
# "cannot move ...settings.json.tmp: No such file or directory". Found while
# running nine models of a model bench in parallel.
# Repo-owned settings fragment (config/settings.json) merged into the agent
# settings on every start, idempotently: object keys are overlaid (jq `*`),
# but `packages` arrays are UNIONED and deduplicated, so user-added packages
# and keys in settings.json are never clobbered. The fragment only declares
# the package; Pi itself installs it into $PI_CODING_AGENT_DIR/npm on start.
FRAG="$ROOT/config/settings.json"
SETTINGS="$PI_CODING_AGENT_DIR/settings.json"
if [ -f "$FRAG" ] && [ -f "$SETTINGS" ] && command -v jq >/dev/null 2>&1; then
	jq -s '
		(.[0].packages // []) as $old |
		(.[1].packages // []) as $new |
		(.[0] * .[1]) | .packages = (($old + $new) | unique)
	' "$SETTINGS" "$FRAG" > "$SETTINGS.$$.tmp" && mv "$SETTINGS.$$.tmp" "$SETTINGS"
fi

NODE="$(command -v node || true)"
[ -z "$NODE" ] && NODE="$HOME/.gentle-shell/runtime/node-24.21.0/bin/node"

# Pi spawns `npm` (the default of settings `npmCommand`) to install declared
# packages; make sure it is reachable even when node only came from the
# gentle-shell runtime dir, which also ships npm.
if ! command -v npm >/dev/null 2>&1; then
	NODEBIN="$(dirname "$NODE")"
	[ -x "$NODEBIN/npm" ] && PATH="$NODEBIN:$PATH" && export PATH
fi

exec "$NODE" "$ROOT/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js" "$@"
